# Copy to .env for `npm run server:dev`. Never commit .env.
# Gemini API key from Google AI Studio (https://aistudio.google.com/apikey). Leave empty to run without Summon.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
# In-memory caps per UTC day; they reset when the server restarts.
DAILY_CAP=100
PER_IP_CAP=10
# Extra origins allowed by CORS, comma-separated. An Origin that matches the server's own Host is always allowed.
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174
PORT=8787
# Directory of the built app (`npm run build`) served on every non-/api path. Set it empty to serve the API only.
STATIC_DIR=dist
